---
import {
  formatScienceMetric,
  type ScienceExhibit,
  type ScienceExhibitExpectation,
} from "../../../src/scienceExhibits.ts";
import evidence from "../../../experiments/results/science-exhibits.json";

type Props = { exhibit: ScienceExhibit };
const { exhibit } = Astro.props;

const registeredExhibit = evidence.exhibits.find(
  (candidate) => candidate.id === exhibit.id,
);
if (!registeredExhibit) {
  throw new Error(`Science evidence is missing exhibit ${exhibit.id}`);
}

const registeredActual = (expectation: ScienceExhibitExpectation) => {
  const registered = registeredExhibit.expectations.find(
    (candidate) => candidate.metric === expectation.metric,
  );
  if (!registered) {
    throw new Error(
      `Science evidence for ${exhibit.id} is missing ${expectation.metric}`,
    );
  }
  return registered;
};

const expectedRange = (expectation: ScienceExhibitExpectation) => {
  const minimum =
    expectation.minimum === undefined
      ? undefined
      : formatScienceMetric(expectation.minimum, expectation.format);
  const maximum =
    expectation.maximum === undefined
      ? undefined
      : formatScienceMetric(expectation.maximum, expectation.format);
  if (minimum !== undefined && maximum !== undefined) {
    return `${minimum}–${maximum}`;
  }
  if (minimum !== undefined) return `≥ ${minimum}`;
  if (maximum !== undefined) return `≤ ${maximum}`;
  return "observed";
};
---

<article
  class="exhibit"
  id={exhibit.id}
  data-science-exhibit
  data-exhibit-id={exhibit.id}
>
  <header class="exhibit-heading">
    <div class="catalogue-number" aria-hidden="true">{exhibit.number}</div>
    <div>
      <p class="eyebrow">{exhibit.eyebrow}</p>
      <h3>{exhibit.title}</h3>
    </div>
  </header>

  <div class="exhibit-body">
    <div class="tank-rail">
      <div class="tank-column" data-tank-column>
        <div class="tank" data-tank>
          <div class="tank-surface">
            <canvas
              aria-label={`${exhibit.title}. ${exhibit.claim}`}
              role="img"
              data-exhibit-canvas></canvas>
          </div>
          <div class="tank-id" aria-hidden="true">
            <span>specimen {exhibit.number}</span>
            <span>step <b data-step>0</b></span>
          </div>
          <div class="wake-panel" data-wake-panel>
            <p data-status aria-live="polite">Specimen sleeping</p>
            <progress
              data-progress
              aria-label={`${exhibit.title} preparation`}
              max={exhibit.measurementStep}
              value="0"
              hidden></progress>
            <span>Wakes in view and runs locally on this device.</span>
          </div>

          <div class="tank-runtime" aria-hidden="true">
            {exhibit.liveFps} fps · DPR 1
          </div>
          <div
            class="tank-controls"
            role="group"
            aria-label={`${exhibit.title} controls`}
          >
            <button
              type="button"
              class="primary"
              data-toggle
              aria-label="Wake specimen"
            >
              <span class="control-icon" data-toggle-icon aria-hidden="true">▶</span>
              <span data-toggle-label>Wake</span>
            </button>
            <button type="button" data-restart aria-label="Restart specimen" disabled>
              <span class="control-icon" aria-hidden="true">↻</span>
              <span>Reset</span>
            </button>
          </div>
        </div>
        <noscript>
          <p class="fallback">
            The live specimen requires JavaScript. Its registered measurements
            remain available below the tank.
          </p>
        </noscript>
      </div>
    </div>

    <div class="exhibit-flow">
      <div class="tank-spacer" aria-hidden="true"></div>
      <div class="collapse-sentinel" data-collapse-sentinel aria-hidden="true"></div>

      <div class="exhibit-copy">
        <p class="question">{exhibit.question}</p>
        <p class="claim">{exhibit.claim}</p>
        <p class="interpretation">{exhibit.interpretation}</p>

        <section class="contract" aria-labelledby={`${exhibit.id}-contract`}>
          <header>
            <div>
              <p>
                Executable claim · step {exhibit.measurementStep.toLocaleString("en-US")}
              </p>
              <h4 id={`${exhibit.id}-contract`}>Registered measurement envelope</h4>
            </div>
            <span class="reproduction" data-reproduction data-state="registered">
              Reproduced by CI
            </span>
          </header>
          <dl>
            {
              exhibit.expectations.map((expectation) => (
                <div data-metric={expectation.metric}>
                  <dt>{expectation.label}</dt>
                  <dd>
                    <span class="expected">{expectedRange(expectation)}</span>
                    <span
                      class="actual"
                      data-actual
                      data-passed={String(registeredActual(expectation).passed)}
                    >
                      {formatScienceMetric(
                        registeredActual(expectation).actual,
                        expectation.format,
                      )}
                    </span>
                  </dd>
                </div>
              ))
            }
          </dl>
          <p class="contract-note">
            These checked-in actuals are regenerated from the same definition used
            by the Worker and deployment test. Passing means this deterministic
            specimen was reproduced—not that the claim is universal across seeds.
          </p>
        </section>
      </div>
    </div>
  </div>
</article>

<script>
  import { ColorInterpolationSystem } from "../../../src/colorInterpolationSystem.ts";
  import { hsbToRgb } from "../../../src/colorUtils.ts";
  import { RenderParams } from "../../../src/renderParams.ts";
  import { formatScienceMetric } from "../../../src/scienceExhibits.ts";

  type FrameMessage = {
    type: "frame";
    step: number;
    width: number;
    height: number;
    moteRadius: number;
    moteX: Float32Array;
    moteY: Float32Array;
    motePressure: Uint8Array;
  };

  type MeasurementMessage = {
    type: "measurement";
    step: number;
    passed: boolean;
    expectations: Array<{
      metric: string;
      actual: number;
      passed: boolean;
      format: "decimal" | "integer" | "percent" | "ratio";
    }>;
  };

  type StatusMessage = {
    type: "status";
    status: "warming";
    step: number;
    targetStep: number;
  };

  type WorkerMessage =
    | FrameMessage
    | MeasurementMessage
    | StatusMessage
    | { type: "complete"; step: number; reason: "registered-limit" }
    | { type: "error"; message: string };

  const colorPoints = new RenderParams().colorInterpolationPoints.map(
    ({ pressure, color }) => ({ pressure, color: { ...color } }),
  );
  const colorSystem = new ColorInterpolationSystem(colorPoints);
  const pressurePalette = Array.from({ length: 16 }, (_, bucket) => {
    const color = colorSystem.getColor(bucket * 16 + 8);
    return hsbToRgb(color.h, color.s, color.b);
  });

  document.querySelectorAll<HTMLElement>("[data-science-exhibit]").forEach(
    (root) => {
      const exhibitId = root.dataset.exhibitId;
      const canvas = root.querySelector<HTMLCanvasElement>(
        "[data-exhibit-canvas]",
      );
      const tank = root.querySelector<HTMLElement>("[data-tank]");
      const collapseSentinel = root.querySelector<HTMLElement>(
        "[data-collapse-sentinel]",
      );
      const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]");
      const toggleIcon = root.querySelector<HTMLElement>("[data-toggle-icon]");
      const toggleLabel = root.querySelector<HTMLElement>("[data-toggle-label]");
      const restart = root.querySelector<HTMLButtonElement>("[data-restart]");
      const status = root.querySelector<HTMLElement>("[data-status]");
      const progress = root.querySelector<HTMLProgressElement>("[data-progress]");
      const stepLabel = root.querySelector<HTMLElement>("[data-step]");
      const reproduction = root.querySelector<HTMLElement>(
        "[data-reproduction]",
      );
      if (
        !exhibitId ||
        !canvas ||
        !tank ||
        !collapseSentinel ||
        !toggle ||
        !toggleIcon ||
        !toggleLabel ||
        !restart ||
        !status ||
        !progress ||
        !stepLabel ||
        !reproduction
      ) {
        return;
      }

      const context = canvas.getContext("2d");
      if (!context) return;

      let worker: Worker | undefined;
      let initialized = false;
      let ready = false;
      let running = false;
      let requestedPlay = false;
      let visible = false;
      let manuallyPaused = false;
      let explicitlyStarted = false;
      let reachedLimit = false;
      let retryBlocked = false;
      let lastFrame: FrameMessage | undefined;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      const setStatus = (message: string) => {
        status.textContent = message;
      };

      const setToggle = (
        label: string,
        icon: string,
        ariaLabel: string,
      ) => {
        toggleLabel.textContent = label;
        toggleIcon.textContent = icon;
        toggle.setAttribute("aria-label", ariaLabel);
        toggle.title = ariaLabel;
      };

      const activate = () => {
        window.dispatchEvent(
          new CustomEvent("polysome:activate-exhibit", { detail: exhibitId }),
        );
      };

      const clearSurface = () => {
        lastFrame = undefined;
        const rect = canvas.getBoundingClientRect();
        const width = Math.max(1, Math.round(rect.width));
        const height = Math.max(1, Math.round(rect.height));
        canvas.width = width;
        canvas.height = height;
        context.fillStyle = "hsl(240 100% 5%)";
        context.fillRect(0, 0, width, height);
        stepLabel.textContent = "0";
      };

      const reportWorkerFailure = (failedWorker?: Worker) => {
        if (failedWorker && worker !== failedWorker) return;
        worker?.terminate();
        worker = undefined;
        initialized = false;
        ready = false;
        running = false;
        requestedPlay = false;
        manuallyPaused = true;
        reachedLimit = false;
        retryBlocked = true;
        toggle.disabled = false;
        restart.disabled = true;
        setToggle("Retry", "↻", "Try specimen again");
        progress.hidden = true;
        tank.dataset.state = "error";
        tank.setAttribute("aria-busy", "false");
        setStatus("Live simulation unavailable; CI measurements remain below");
      };

      const draw = (frame: FrameMessage) => {
        const rect = canvas.getBoundingClientRect();
        const width = Math.max(1, Math.round(rect.width));
        const height = Math.max(1, Math.round(rect.height));
        if (canvas.width !== width || canvas.height !== height) {
          canvas.width = width;
          canvas.height = height;
        }

        context.fillStyle = "hsl(240 100% 5%)";
        context.fillRect(0, 0, width, height);
        // Keep the world at a constant, width-fitted scale. The compact tank is
        // a cropped window onto this same surface, never a smaller simulation.
        const scale = width / frame.width;
        const offsetX = (width - frame.width * scale) / 2;
        const offsetY = (height - frame.height * scale) / 2;
        const radius = Math.max(0.75, frame.moteRadius * 0.07 * scale);
        const paths = Array.from({ length: pressurePalette.length }, () =>
          new Path2D(),
        );

        for (let index = 0; index < frame.moteX.length; index++) {
          const bucket = Math.min(15, frame.motePressure[index] >> 4);
          const x = offsetX + frame.moteX[index] * scale;
          const y = offsetY + frame.moteY[index] * scale;
          if (
            x < -radius ||
            x > width + radius ||
            y < -radius ||
            y > height + radius
          ) {
            continue;
          }
          paths[bucket].moveTo(x + radius, y);
          paths[bucket].arc(x, y, radius, 0, Math.PI * 2);
        }

        context.lineWidth = Math.max(0.5, 0.5 * scale);
        for (let bucket = 0; bucket < paths.length; bucket++) {
          context.strokeStyle = pressurePalette[bucket];
          context.stroke(paths[bucket]);
        }
        stepLabel.textContent = frame.step.toLocaleString("en-US");
      };

      const updatePlayback = () => {
        const shouldRun =
          initialized &&
          requestedPlay &&
          visible &&
          !document.hidden &&
          !reachedLimit;
        if (shouldRun !== running) {
          running = shouldRun;
          worker?.postMessage({ type: shouldRun ? "play" : "pause" });
        }
        if (reachedLimit) {
          toggle.disabled = true;
          setToggle("Limit", "■", "Safe simulation limit reached");
        } else if (ready || initialized) {
          toggle.disabled = false;
          setToggle(
            shouldRun ? "Pause" : "Resume",
            shouldRun ? "Ⅱ" : "▶",
            shouldRun ? "Pause specimen" : "Resume specimen",
          );
        }
        if (ready) {
          setStatus(shouldRun ? "Specimen alive" : "Specimen paused");
        } else if (initialized && !shouldRun) {
          setStatus("Specimen preparation paused");
        }
      };

      const initialize = () => {
        if (worker) {
          worker.terminate();
          worker = undefined;
        }
        clearSurface();
        reproduction.dataset.state = "registered";
        reproduction.textContent = "CI reference · local run pending";

        const activeWorker = new Worker(
          new URL("../science/exhibit.worker.ts", import.meta.url),
          { type: "module" },
        );
        worker = activeWorker;
        initialized = true;
        ready = false;
        running = false;
        reachedLimit = false;
        retryBlocked = false;
        restart.disabled = false;
        toggle.disabled = false;
        setToggle("Pause", "Ⅱ", "Pause specimen");
        progress.hidden = false;
        progress.value = 0;
        tank.dataset.state = "warming";
        tank.setAttribute("aria-busy", "true");
        setStatus("Growing specimen to its registered observation");

        activeWorker.addEventListener(
          "message",
          (event: MessageEvent<WorkerMessage>) => {
            if (worker !== activeWorker) return;
            const message = event.data;
            if (message.type === "status") {
              progress.max = message.targetStep;
              progress.value = message.step;
              stepLabel.textContent = message.step.toLocaleString("en-US");
              return;
            }

            if (message.type === "frame") {
              lastFrame = message;
              draw(message);
              return;
            }

            if (message.type === "measurement") {
              ready = true;
              progress.hidden = true;
              restart.disabled = false;
              toggle.disabled = false;
              tank.dataset.state = "ready";
              tank.setAttribute("aria-busy", "false");
              reproduction.dataset.state = message.passed ? "passed" : "failed";
              reproduction.textContent = message.passed
                ? "Reproduced on this device"
                : "Outside registered envelope";
              for (const expectation of message.expectations) {
                const row = Array.from(
                  root.querySelectorAll<HTMLElement>("[data-metric]"),
                ).find(
                  (candidate) => candidate.dataset.metric === expectation.metric,
                );
                const actual = row?.querySelector<HTMLElement>("[data-actual]");
                if (actual) {
                  actual.textContent = formatScienceMetric(
                    expectation.actual,
                    expectation.format,
                  );
                  actual.dataset.passed = String(expectation.passed);
                }
              }
              updatePlayback();
              return;
            }

            if (message.type === "complete") {
              requestedPlay = false;
              running = false;
              reachedLimit = true;
              updatePlayback();
              setStatus(
                "Specimen paused at its safe limit; restart to watch again",
              );
              return;
            }

            if (message.type === "error") {
              reportWorkerFailure(activeWorker);
            }
          },
        );
        activeWorker.addEventListener("error", () =>
          reportWorkerFailure(activeWorker),
        );
        activeWorker.addEventListener("messageerror", () =>
          reportWorkerFailure(activeWorker),
        );
        activeWorker.postMessage({ type: "initialize", exhibitId });
        updatePlayback();
      };

      toggle.addEventListener("click", () => {
        if (!initialized || tank.dataset.state === "error") {
          activate();
          manuallyPaused = false;
          explicitlyStarted = true;
          retryBlocked = false;
          requestedPlay = true;
          initialize();
          return;
        }
        if (requestedPlay) {
          requestedPlay = false;
          manuallyPaused = true;
        } else {
          activate();
          requestedPlay = true;
          manuallyPaused = false;
          explicitlyStarted = true;
        }
        updatePlayback();
      });

      restart.addEventListener("click", () => {
        activate();
        manuallyPaused = false;
        explicitlyStarted = true;
        retryBlocked = false;
        requestedPlay = true;
        initialize();
      });

      window.addEventListener("polysome:activate-exhibit", (event) => {
        const activatedId = (event as CustomEvent<string>).detail;
        if (activatedId !== exhibitId && requestedPlay) {
          requestedPlay = false;
          updatePlayback();
        }
      });

      const autoWake = () => {
        if (
          !visible ||
          document.hidden ||
          (reducedMotion.matches && !explicitlyStarted) ||
          manuallyPaused ||
          reachedLimit ||
          retryBlocked
        ) {
          updatePlayback();
          return;
        }
        activate();
        requestedPlay = true;
        if (!initialized) {
          initialize();
        } else {
          updatePlayback();
        }
      };

      const intersection = new IntersectionObserver(
        ([entry]) => {
          const wasVisible = visible;
          visible = entry.isIntersecting && entry.intersectionRatio >= 0.2;
          if (visible && !wasVisible) {
            autoWake();
          } else {
            updatePlayback();
          }
        },
        { threshold: [0, 0.2, 0.6] },
      );
      intersection.observe(tank);

      const resize = new ResizeObserver(() => {
        if (lastFrame) draw(lastFrame);
      });
      resize.observe(canvas);

      let collapse: IntersectionObserver | undefined;
      const siteHeader = document.querySelector<HTMLElement>(".site-header");
      const configureStickyBoundary = () => {
        const stickyTop = Math.ceil(siteHeader?.getBoundingClientRect().height ?? 0);
        root.style.setProperty("--science-sticky-top", `${stickyTop}px`);
        collapse?.disconnect();
        collapse = new IntersectionObserver(
          ([entry]) => {
            const compact =
              !entry.isIntersecting && entry.boundingClientRect.top < stickyTop;
            root.toggleAttribute("data-compact", compact);
          },
          {
            rootMargin: `-${stickyTop}px 0px 0px 0px`,
            threshold: 0,
          },
        );
        collapse.observe(collapseSentinel);
      };
      configureStickyBoundary();

      const headerResize = new ResizeObserver(configureStickyBoundary);
      if (siteHeader) headerResize.observe(siteHeader);

      const handleVisibilityChange = () => {
        if (visible && !document.hidden) {
          autoWake();
        } else {
          updatePlayback();
        }
      };
      const handleReducedMotionChange = () => {
        if (reducedMotion.matches && !explicitlyStarted) {
          requestedPlay = false;
          updatePlayback();
        } else if (!reducedMotion.matches) {
          autoWake();
        }
      };

      document.addEventListener("visibilitychange", handleVisibilityChange);
      reducedMotion.addEventListener("change", handleReducedMotionChange);

      const refreshVisibility = () => {
        const rect = tank.getBoundingClientRect();
        const visibleHeight = Math.max(
          0,
          Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0),
        );
        visible = visibleHeight / Math.max(1, rect.height) >= 0.2;
      };

      const cleanup = () => {
        intersection.disconnect();
        resize.disconnect();
        collapse?.disconnect();
        headerResize.disconnect();
        document.removeEventListener("visibilitychange", handleVisibilityChange);
        reducedMotion.removeEventListener("change", handleReducedMotionChange);
        window.removeEventListener("pagehide", handlePageHide);
        window.removeEventListener("pageshow", handlePageShow);
        worker?.terminate();
        worker = undefined;
      };

      const handlePageHide = (event: PageTransitionEvent) => {
        if (event.persisted) {
          running = false;
          worker?.postMessage({ type: "pause" });
          return;
        }
        cleanup();
      };

      const handlePageShow = (event: PageTransitionEvent) => {
        if (!event.persisted) return;
        configureStickyBoundary();
        refreshVisibility();
        autoWake();
      };

      window.addEventListener("pagehide", handlePageHide);
      window.addEventListener("pageshow", handlePageShow);
    },
  );
</script>

<style>
  .exhibit {
    --tank-compact-height: min(46svh, 80.28vw);
    --tank-expanded-height: min(82svh, 160.56vw);
    --tank-sticky-top: 4.5rem;
    border-top: 1px solid hsl(270 35% 42% / 35%);
    overflow-anchor: none;
    padding: clamp(3rem, 9vw, 6rem) 0;
    scroll-margin-top: 5rem;
  }

  .exhibit-heading {
    align-items: start;
    display: grid;
    gap: 1rem;
    grid-template-columns: auto minmax(0, 1fr);
    margin-bottom: 1.5rem;
  }

  .catalogue-number {
    border: 1px solid hsl(186 55% 55% / 45%);
    border-radius: 999px;
    color: hsl(184 75% 70%);
    display: grid;
    font: 0.72rem ui-monospace, SFMono-Regular, Menlo, monospace;
    height: 2.4rem;
    place-items: center;
    width: 2.4rem;
  }

  .eyebrow {
    color: hsl(315 72% 70%);
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    margin: 0 0 0.35rem;
    text-transform: uppercase;
  }

  h3 {
    color: hsl(300 45% 94%);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.85rem, 7vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.04;
    margin: 0;
    text-wrap: balance;
  }

  .exhibit-body {
    display: grid;
    position: relative;
  }

  .tank-rail,
  .exhibit-flow {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .tank-rail {
    align-self: stretch;
    pointer-events: none;
    position: relative;
    z-index: 8;
  }

  .tank-column {
    height: var(--tank-expanded-height);
    pointer-events: none;
    position: sticky;
    top: var(--science-sticky-top);
  }

  .tank {
    background:
      radial-gradient(circle at 50% 45%, hsl(270 80% 18% / 28%), transparent 48%),
      hsl(240 100% 5%);
    border: 1px solid hsl(274 55% 52% / 34%);
    border-radius: 1.35rem;
    box-shadow:
      inset 0 0 4rem hsl(260 80% 15% / 30%),
      0 2rem 5rem hsl(250 100% 2% / 55%);
    height: var(--tank-expanded-height);
    overflow: hidden;
    pointer-events: auto;
    position: relative;
    touch-action: pan-y;
    width: 100%;
  }

  [data-compact] .tank {
    height: var(--tank-compact-height);
  }

  .tank-surface {
    height: var(--tank-expanded-height);
    left: 0;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
  }

  canvas {
    display: block;
    height: 100%;
    width: 100%;
  }

  .exhibit-flow {
    position: relative;
    z-index: 1;
  }

  .tank-spacer {
    height: var(--tank-expanded-height);
  }

  .collapse-sentinel {
    height: 1px;
    pointer-events: none;
  }

  .tank-id {
    color: hsl(260 18% 70%);
    display: flex;
    font: 0.62rem ui-monospace, SFMono-Regular, Menlo, monospace;
    justify-content: space-between;
    left: 0;
    letter-spacing: 0.08em;
    padding-bottom: 0.75rem;
    padding-left: max(0.75rem, env(safe-area-inset-left));
    padding-right: max(0.75rem, env(safe-area-inset-right));
    padding-top: 0.75rem;
    position: absolute;
    right: 0;
    text-transform: uppercase;
    top: 0;
  }

  .wake-panel {
    background: hsl(244 55% 7% / 68%);
    border: 1px solid hsl(272 48% 50% / 34%);
    border-radius: 0.85rem;
    bottom: 5.1rem;
    left: max(1rem, env(safe-area-inset-left));
    max-width: 28rem;
    padding: 0.8rem;
    position: absolute;
    right: max(1rem, env(safe-area-inset-right));
    z-index: 2;
  }

  [data-state="ready"] .wake-panel {
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms ease;
  }

  .wake-panel p {
    color: hsl(300 45% 91%);
    font-size: 0.8rem;
    margin: 0;
  }

  .wake-panel span {
    color: hsl(260 15% 66%);
    display: block;
    font-size: 0.68rem;
    line-height: 1.35;
    margin-top: 0.35rem;
  }

  progress {
    accent-color: hsl(315 82% 62%);
    display: block;
    height: 0.35rem;
    margin: 0.6rem 0 0;
