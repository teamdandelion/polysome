---
import NotebookEntry from "../../components/NotebookEntry.astro";
import { HELLO_WORLD_NOTEBOOK } from "../../notebooks/helloWorld.ts";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="description"
      content="A hello-world scaffold for live Polysome notebooks."
    />
    <meta name="theme-color" content="#05051a" />
    <title>Polysome notebooks</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Return to Polysome artwork">
        <span>Polysome</span>
        <i>/ notebooks</i>
      </a>
      <a class="artwork-link" href="/">Artwork</a>
    </header>

    <main>
      <section class="hero" aria-labelledby="page-title">
        <p class="overline">Polysome notebooks</p>
        <h1 id="page-title">A live simulation,<br /><em>inside the notes.</em></h1>
        <p class="dek">
          A minimal notebook scaffold running the Polysome source deployed with
          this page. The simulation advances in a Web Worker; the page draws each
          returned state.
        </p>
      </section>

      <section class="notebook" aria-label="Hello-world notebook entry">
        <NotebookEntry notebook={HELLO_WORLD_NOTEBOOK} />
      </section>
    </main>

    <footer>
      <a href="/">Return to the artwork</a>
      <p>Polysome · Dandelion Mané · notebook hello world</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --page-gutter-left: max(1.15rem, env(safe-area-inset-left));
    --page-gutter-right: max(1.15rem, env(safe-area-inset-right));
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: hsl(246 52% 4%);
  }

  body {
    background:
      radial-gradient(circle at 15% 0%, hsl(285 75% 17% / 25%), transparent 25rem),
      hsl(246 52% 4%);
    color: hsl(270 20% 88%);
    margin: 0;
    min-height: 100%;
  }

  a {
    color: inherit;
  }

  .site-header {
    align-items: center;
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    background: hsl(246 52% 4% / 84%);
    border-bottom: 1px solid hsl(270 36% 42% / 24%);
    display: flex;
    justify-content: space-between;
    left: 0;
    padding:
      max(0.75rem, env(safe-area-inset-top))
      max(1rem, env(safe-area-inset-right)) 0.75rem
      max(1rem, env(safe-area-inset-left));
    position: sticky;
    right: 0;
    top: 0;
    z-index: 20;
  }

  .wordmark,
  .artwork-link {
    align-items: center;
    display: flex;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .wordmark {
    font-size: 0.84rem;
    gap: 0.35rem;
  }

  .wordmark span {
    color: hsl(315 80% 72%);
    font-weight: 650;
  }

  .wordmark i {
    color: hsl(260 16% 68%);
    font-style: normal;
  }

  .artwork-link {
    color: hsl(260 14% 72%);
    font-size: 0.72rem;
    padding-inline: 0.5rem;
  }

  .wordmark:hover,
  .wordmark:focus-visible,
  .artwork-link:hover,
  .artwork-link:focus-visible {
    color: white;
  }

  main,
  footer {
    margin: 0 auto;
    max-width: 74rem;
    padding-left: var(--page-gutter-left);
    padding-right: var(--page-gutter-right);
  }

  .hero {
    max-width: 58rem;
    padding: clamp(3rem, 9vw, 5rem) 0;
  }

  .overline {
    color: hsl(184 68% 67%);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    margin: 0 0 1rem;
    text-transform: uppercase;
  }

  h1 {
    color: hsl(300 45% 95%);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 13vw, 6.8rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.92;
    margin: 0;
    text-wrap: balance;
  }

  h1 em {
    color: hsl(316 72% 71%);
    font-weight: 400;
  }

  .dek {
    color: hsl(265 18% 76%);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.1rem, 4vw, 1.45rem);
    line-height: 1.6;
    margin: 1.5rem 0 0;
    max-width: 46rem;
  }

  footer {
    align-items: center;
    border-top: 1px solid hsl(270 36% 42% / 30%);
    color: hsl(260 12% 58%);
    display: flex;
    font-size: 0.7rem;
    justify-content: space-between;
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
    padding-top: 2rem;
  }

  footer a {
    color: hsl(315 68% 72%);
  }

  footer p {
    margin: 0;
  }
</style>
