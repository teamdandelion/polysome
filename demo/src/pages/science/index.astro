---
import ScienceExhibit from "../../components/ScienceExhibit.astro";
import { NOTEBOOK_EXHIBITS } from "../../science/notebook.ts";
import baseline from "../../../../experiments/results/current-portrait-baseline.json";
import evidence from "../../../../experiments/results/science-exhibits.json";

const referenceExhibit = NOTEBOOK_EXHIBITS[0];
const registeredEvidence = evidence.exhibits.find(
  ({ id }) => id === referenceExhibit.id,
);
if (!registeredEvidence) {
  throw new Error(`Notebook evidence is missing ${referenceExhibit.id}`);
}

const checksPassed = registeredEvidence.expectations.filter(
  ({ passed }) => passed,
).length;
const checksTotal = registeredEvidence.expectations.length;
const shortCommit = baseline.provenance.gitCommit?.slice(0, 7) ?? "archived";
const definitionHash = registeredEvidence.identity.definitionSha256
  .replace("sha256:", "")
  .slice(0, 12);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="description"
      content="The minimal executable scaffold for the Polysome science notebook."
    />
    <meta name="theme-color" content="#05051a" />
    <title>Polysome — Science notebook</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Return to Polysome artwork">
        <span>Polysome</span>
        <i>/ notebook</i>
      </a>
      <a class="artwork-link" href="/">Artwork</a>
    </header>

    <main>
      <section class="hero" aria-labelledby="page-title">
        <p class="overline">Science notebook · scaffold</p>
        <h1 id="page-title">The notebook works.<br /><em>Now we can investigate.</em></h1>
        <p class="dek">
          This page is deliberately small. It proves that we can define one
          Polysome run, grow it live, measure it without rendering, and ask CI to
          reproduce it on every proposed change. It does not yet explain the forms
          Polysome makes.
        </p>

        <dl class="status" aria-label="Notebook scope">
          <div>
            <dt>Published</dt>
            <dd>{NOTEBOOK_EXHIBITS.length} reference specimen</dd>
          </div>
          <div>
            <dt>Checked</dt>
            <dd>{checksPassed} / {checksTotal} diagnostic ranges</dd>
          </div>
          <div>
            <dt>Claimed</dt>
            <dd>Reproducibility only</dd>
          </div>
        </dl>
      </section>

      <section class="specimen" id="specimen" aria-label="Notebook instrument check">
        {
          NOTEBOOK_EXHIBITS.map((exhibit) => (
            <ScienceExhibit exhibit={exhibit} />
          ))
        }
      </section>

      <section class="protocol" id="protocol" aria-labelledby="protocol-title">
        <div class="section-intro">
          <p class="overline">Current scope</p>
          <h2 id="protocol-title">What works—and what remains unknown.</h2>
        </div>

        <div class="scope-grid">
          <article>
            <p class="scope-label established">Established here</p>
            <ul>
              <li>A complete seed, parameter recipe, and observation step.</li>
              <li>State evolution separated from rendering in a Web Worker.</li>
              <li>The same full-fidelity renderer used by the artwork.</li>
              <li>A CI gate over three deterministic diagnostics.</li>
            </ul>
          </article>
          <article>
            <p class="scope-label unknown">Not established here</p>
            <ul>
              <li>Whether these diagnostics capture the visual phenotype.</li>
              <li>Whether this seed or moment is representative.</li>
              <li>Why clumps, voids, and one or two cores form.</li>
              <li>Which simpler rules would preserve the behavior.</li>
            </ul>
          </article>
        </div>

        <div class="provenance" aria-label="Reference specimen provenance">
          <div>
            <p>Kernel / metrics</p>
            <strong>{referenceExhibit.dynamicsVersion}<br />{referenceExhibit.metricVersion}</strong>
          </div>
          <div>
            <p>Baseline commit</p>
            <strong>{shortCommit}</strong>
          </div>
          <div>
            <p>Run / definition</p>
            <strong>{baseline.runId.slice(0, 10)}…<br />{definitionHash}…</strong>
          </div>
          <a href="https://github.com/teamdandelion/polysome/blob/main/docs/science.md"
            >Research plan</a
          >
        </div>
      </section>

      <section class="next-question" aria-labelledby="next-title">
        <p class="overline">First real question</p>
        <h2 id="next-title">How should we measure what we can already see?</h2>
        <p>
          We need a reproducible description of clustered islands separated by
          voids around one or two cores—one that agrees with perception without
          hard-coding the desired answer. That measurement is where the next
          notebook entry begins.
        </p>
      </section>
    </main>

    <footer>
      <a href="/">Return to the artwork</a>
      <p>Polysome · Dandelion Mané · notebook scaffold</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --page-gutter-left: max(1.15rem, env(safe-area-inset-left));
    --page-gutter-right: max(1.15rem, env(safe-area-inset-right));
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    scroll-behavior: smooth;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: hsl(246 52% 4%);
  }

  body {
    background:
      radial-gradient(circle at 15% 0%, hsl(285 75% 17% / 25%), transparent 25rem),
      hsl(246 52% 4%);
    color: hsl(270 20% 88%);
    margin: 0;
    min-height: 100%;
  }

  a {
    color: inherit;
  }

  .site-header {
    align-items: center;
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    background: hsl(246 52% 4% / 84%);
    border-bottom: 1px solid hsl(270 36% 42% / 24%);
    display: flex;
    justify-content: space-between;
    left: 0;
    padding:
      max(0.75rem, env(safe-area-inset-top))
      max(1rem, env(safe-area-inset-right)) 0.75rem
      max(1rem, env(safe-area-inset-left));
    position: sticky;
    right: 0;
    top: 0;
    z-index: 20;
  }

  .wordmark,
  .artwork-link {
    align-items: center;
    display: flex;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .wordmark {
    font-size: 0.84rem;
    gap: 0.35rem;
  }

  .wordmark span {
    color: hsl(315 80% 72%);
    font-weight: 650;
  }

  .wordmark i {
    color: hsl(260 16% 68%);
    font-style: normal;
  }

  .artwork-link {
    color: hsl(260 14% 72%);
    font-size: 0.72rem;
    padding-inline: 0.5rem;
  }

  .wordmark:hover,
  .wordmark:focus-visible,
  .artwork-link:hover,
  .artwork-link:focus-visible {
    color: white;
  }

  main,
  footer {
    margin: 0 auto;
    max-width: 74rem;
    padding-left: var(--page-gutter-left);
    padding-right: var(--page-gutter-right);
  }

  .hero {
    max-width: 56rem;
    padding-bottom: clamp(3rem, 9vw, 5rem);
    padding-top: clamp(3rem, 9vw, 5rem);
  }

  .overline {
    color: hsl(184 68% 67%);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    margin: 0 0 1rem;
    text-transform: uppercase;
  }

  h1,
  h2 {
    color: hsl(300 45% 95%);
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: -0.04em;
    margin: 0;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(3rem, 13vw, 6.8rem);
    line-height: 0.92;
  }

  h1 em {
    color: hsl(316 72% 71%);
    font-weight: 400;
  }

  h2 {
    font-size: clamp(2.35rem, 9vw, 5rem);
    line-height: 0.98;
  }

  .dek,
  .section-intro > p:last-child,
  .next-question > p:last-child {
    color: hsl(265 18% 76%);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.1rem, 4vw, 1.45rem);
    line-height: 1.6;
    margin: 1.5rem 0 0;
    max-width: 44rem;
  }

  .status {
    background: hsl(246 38% 8% / 74%);
    border: 1px solid hsl(272 38% 44% / 34%);
    border-radius: 1rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 2rem 0 0;
    overflow: hidden;
  }

  .status > div {
    border-left: 1px solid hsl(260 28% 42% / 25%);
    padding: 0.75rem;
  }

  .status > div:first-child {
    border-left: 0;
  }

  .status dt,
  .provenance p {
    color: hsl(260 13% 60%);
    font-size: 0.67rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status dd {
    color: hsl(290 24% 88%);
    font-size: 0.75rem;
    margin: 0.25rem 0 0;
  }

  .protocol,
  .next-question {
    border-top: 1px solid hsl(270 36% 42% / 30%);
    padding: clamp(4rem, 12vw, 7rem) 0;
    scroll-margin-top: 4rem;
  }

  .specimen {
    scroll-margin-top: 4rem;
  }

  .section-intro {
    max-width: 49rem;
  }

  .scope-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .scope-grid article {
    background: hsl(246 34% 8% / 72%);
    border: 1px solid hsl(264 32% 42% / 30%);
    border-radius: 1rem;
    padding: 1.15rem;
  }

  .scope-label {
    font: 0.7rem ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.09em;
    margin: 0;
    text-transform: uppercase;
  }

  .scope-label.established {
    color: hsl(150 53% 72%);
  }

  .scope-label.unknown {
    color: hsl(43 78% 72%);
  }

  .scope-grid ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .scope-grid li {
    border-top: 1px solid hsl(260 28% 42% / 25%);
    color: hsl(260 16% 73%);
    font-size: 0.9rem;
    line-height: 1.5;
    padding: 0.7rem 0;
  }

  .scope-grid li::before {
    color: hsl(315 68% 70%);
    content: "·";
    margin-right: 0.55rem;
  }

  .provenance {
    background: hsl(246 40% 8%);
    border: 1px solid hsl(270 34% 44% / 35%);
    border-radius: 1rem;
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1rem;
  }

  .provenance p {
    margin: 0 0 0.3rem;
  }

  .provenance strong {
    color: hsl(150 50% 71%);
    font: 0.76rem/1.55 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .provenance a {
    align-self: center;
    color: hsl(184 65% 72%);
    font-size: 0.8rem;
  }

  .next-question {
    max-width: 50rem;
  }

  footer {
    border-top: 1px solid hsl(270 36% 42% / 30%);
    color: hsl(260 12% 58%);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.72rem;
    gap: 1rem;
    justify-content: space-between;
    padding-bottom: max(3rem, env(safe-area-inset-bottom));
    padding-top: 2rem;
  }

  footer a {
    color: hsl(315 60% 72%);
  }

  footer p {
    margin: 0;
  }

  @media (min-width: 44rem) {
    .scope-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .provenance {
      grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :root {
      scroll-behavior: auto;
    }
  }
</style>
